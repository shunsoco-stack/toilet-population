{
  "name": "toilet-population",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "世界トイレ人口 — ひとりの時間も、なんとなくつながる。",
  "engines": { "node": "24.x" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:rules": "firebase emulators:exec --only firestore --project demo-toilet-population \"vitest run --config vitest.rules.config.ts\"",
    "assets": "node scripts/generate-assets.mjs",
    "secret:scan": "node scripts/secret-scan.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run secret:scan && npm run build"
  },
  "dependencies": {
    "@vercel/analytics": "2.0.1",
    "firebase": "12.18.0",
    "lucide-react": "1.28.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.3",
    "firebase-tools": "^15.25.1",
    "jsdom": "^30.0.1",
    "sharp": "0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
