# このファイルを .env.local にコピーしてください。
# Firebase 未設定なら明示的なデモモードで起動します。
# NEXT_PUBLIC_* はブラウザーに公開される設定です。秘密鍵や管理者トークンは入れないでください。

# 公開先 URL。ローカル開発時の既定値です。Vercel 公開時に実際の URL へ変更します。
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Firebase Console > プロジェクトの設定 > マイアプリ > Web アプリの公開設定
# 必須（4項目すべてを設定すると Firebase モードになります）
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Web アプリの設定に含まれる任意項目（このアプリは Storage / Messaging を利用しません）
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# ローカルのAuth/Firestoreエミュレーター利用時だけtrue。本番ではfalseまたは未設定。
NEXT_PUBLIC_FIREBASE_USE_EMULATORS=false

# Firebase Admin SDK / サービスアカウントの JSON / Vercel Token は不要です。
# 公開設定を変更したら再ビルド・再デプロイしてください。
